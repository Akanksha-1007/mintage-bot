rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true;
    }
    match /bot_configurations/{botId} {
      allow read: if true;
      allow write: if true;
    }
    match /leads/{leadId} {
      allow read, create, update: if true;
      allow delete: if request.auth != null;
    }
  }
}
